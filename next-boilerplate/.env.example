# Base URL for API calls made via lib/apiClient.ts.
# Defaults to a public demo API (JSONPlaceholder) when unset, so the /users
# demo works out of the box. Point this at your real backend per environment.
NEXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com

# Admin panel demo login (app/admin) — server-only, never exposed to the
# client. There is no real user store behind this; replace it with proper
# auth (hashed passwords, a real session store) before using this anywhere
# but a local demo.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-me-in-production
